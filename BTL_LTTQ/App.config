<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!--
			Chuỗi kết nối SQL Server của ứng dụng.
			Data Source: tên instance SQL Server đang chạy trên máy.
			Máy này có 2 instance: SQLEXPRESS (đang chứa database) và SQLEXPRESS01.
			Đổi thành (local)\SQLEXPRESS nếu chạy trên máy khác, hoặc .\SQLEXPRESS cho instance cục bộ.
			Integrated Security=True: đăng nhập bằng tài khoản Windows, không lưu mật khẩu trong file.
		-->
		<add name="DB"
			 connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=QuanLyLopTinHocVaNgoaiNguNganHan;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
			 providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
</configuration>
